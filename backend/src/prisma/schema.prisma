generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model companies {
  id           String   @id @default(uuid())
  company_name String   @unique(map: "Companies_company_name_key") @db.VarChar(255)
  email        String?  @db.VarChar(100)
  address      String?  @db.Text
  description  String?  @db.Text
  website      String?  @db.Text
  field        String?  @db.VarChar(100)
  imageUrl     String?  @db.Text
  sourceUrl    String?  @db.Text
  source_name  String?  @db.VarChar(150)
  employees    Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  jobs         jobs[]
}

model cvs {
  id           String      @id @default(uuid())
  fullname     String      @db.VarChar(50)
  phone        String?     @db.VarChar(20)
  email        String?     @db.VarChar(100)
  address      String?     @db.Text
  description  String?     @db.Text
  experience   String?     @db.Text
  skills       String?     @db.Text
  education    String?     @db.Text
  certificates String?     @db.Text
  others       String?     @db.Text
  apply_job    String?     @db.Text
  hobbies      String?     @db.Text
  references   String?     @db.Text
  languages    String?     @db.Text
  user_id      String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  projects     String?     @db.Text
  users        users       @relation(fields: [user_id], references: [id], map: "Cvs_user_id_fkey")
  matchings    matchings[]

  @@index([user_id], map: "Cvs_user_id_fkey")
}

model jobs {
  id             String      @id @default(uuid())
  title          String      @db.VarChar(255)
  salary         String?     @db.VarChar(80)
  description    String?     @db.Text
  endDate        DateTime?   @db.Date
  apply_location String?     @db.VarChar(150)
  experience     String?     @db.Text
  form_of_work   String?     @db.VarChar(50)
  job_level      String?     @db.VarChar(50)
  education      String?     @db.VarChar(50)
  tags           String?     @db.Text
  quantity       Int?
  sourceUrl      String?     @db.Text
  company_id     String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  companies      companies   @relation(fields: [company_id], references: [id], map: "Jobs_company_id_fkey")
  matchings      matchings[]

  @@index([company_id], map: "Jobs_company_id_fkey")
}

model matchings {
  id         String   @id
  score      Decimal  @db.Decimal(5, 2)
  cv_id      String
  job_id     String
  created_at DateTime @default(now())
  cvs        cvs      @relation(fields: [cv_id], references: [id], map: "Matchings_cv_id_fkey")
  jobs       jobs     @relation(fields: [job_id], references: [id], map: "Matchings_job_id_fkey")

  @@index([cv_id], map: "Matchings_cv_id_fkey")
  @@index([job_id], map: "Matchings_job_id_fkey")
}

model users {
  id          String   @id @default(uuid())
  username    String   @db.VarChar(50)
  email       String   @db.VarChar(100)
  password    String   @db.VarChar(255)
  imageUrl    String?  @db.Text
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  cvs         cvs[]
}
